    {name:'Heineken',        w:20,ing:[{k:'Heineken',ml:330}]},
    {name:'Vino Septima',    w:20,ing:[{k:'Vino Septima',ml:150}]},
    {name:'Espumante Cod.',  w:18,ing:[{k:'Espumante',ml:150}]},
    {name:'Caipirinha',      w:15,ing:[{k:'Cachaça',ml:60},{k:'Jugo limón/lima',ml:20},{k:'Azúcar',ml:15}]},
    {name:'JW Red Label',    w:15,ing:[{k:'Whisky JW Red',ml:50}]},
    {name:'Penicillin',      w:12,ing:[{k:'Whisky JW Red',ml:60},{k:'Jugo limón/lima',ml:22},{k:'Syrup miel',ml:22},{k:'Jugo jengibre',ml:15}]},
  ]
};

function fmt(n){return Math.round(n).toLocaleString('es-AR');}
function allDrinks(t){var a=DR.estandar.slice();if(t==='plus'||t==='autor')a=a.concat(DR.plus);if(t==='autor')a=a.concat(DR.autor);return a;}

function calcMap(){
  var td=Math.round(CS.guests*CS.hours*CS.tph),mf=1+CS.marg/100;
  var all=allDrinks(CS.bar),tw=all.reduce(function(s,d){return s+d.w;},0),map={};
  all.forEach(function(d){
    var cnt=td*(d.w/(tw||1));
    d.ing.forEach(function(i){if(!map[i.k])map[i.k]=0;map[i.k]+=cnt*i.ml*mf;});
  });
  return {td:td,map:map};
}

function render(){
  var r=calcMap(),keys=Object.keys(r.map).sort(function(a,b){return r.map[b]-r.map[a];});
  var pp=CS.bar==='estandar'?18000:CS.bar==='plus'?26000:30000;
  var rev=CS.guests*pp,cost=0,miss=[];
  keys.forEach(function(k){
    var i=ING[k];if(!i)return;
    var u=Math.ceil(r.map[k]/i.vol);
    if(i.p!=null)cost+=u*i.p;
    else if(miss.indexOf(k)<0)miss.push(k);
  });
  var mg=rev-cost,mp=rev>0?Math.round(mg/rev*100):0;

  document.getElementById('summ').innerHTML=
    '<div class="sc"><div class="sc-l">Tragos estimados</div><div class="sc-v">'+fmt(r.td)+'</div><div class="sc-s">'+CS.guests+'p × '+CS.hours+'hs × '+CS.tph+'/hs</div></div>'+
    '<div class="sc"><div class="sc-l">Costo insumos</div><div class="sc-v '+(miss.length?'a':'')+'">$'+fmt(cost)+'</div><div class="sc-s">'+(miss.length?miss.length+' pendientes':'Completo')+'</div></div>'+
    '<div class="sc"><div class="sc-l">Ingreso bruto</div><div class="sc-v">$'+fmt(rev)+'</div><div class="sc-s">$'+fmt(pp)+'/persona</div></div>'+
    '<div class="sc"><div class="sc-l">Margen s/ insumos</div><div class="sc-v '+(mp>=50?'g':'a')+'">'+mp+'%</div><div class="sc-s">$'+fmt(mg)+' disponible</div></div>';

  var rows='',shown=0;
  keys.forEach(function(k){
    var i=ING[k];if(!i)return;
    var u=Math.ceil(r.map[k]/i.vol),c=i.p!=null?u*i.p:null;
    if(c!=null)shown+=c;
    rows+='<tr>'+
      '<td>'+(i.alc?'<span class="alcd">⬤</span>':'<span class="mixd">⬤</span>')+k+(i.note?'<br><small style="color:rgba(245,237,224,.3)">'+i.note+'</small>':'')+'</td>'+
      '<td>'+(r.map[k]/1000).toFixed(2)+'</td>'+
      '<td><strong>'+u+'</strong><span style="font-size:10px;color:rgba(245,237,224,.4)"> × '+i.unit+'</span></td>'+
      '<td>'+(i.p!=null?'$'+fmt(i.p):'<span class="bp">pendiente</span>')+'</td>'+
      '<td style="font-weight:600">'+(c!=null?'$'+fmt(c):'<span style="color:#e09a3a;font-style:italic;font-size:11px">—</span>')+'</td></tr>';
  });
  rows+='<tr class="ttr"><td colspan="3">'+(miss.length?'Subtotal (sin pendientes)':'Total insumos')+'</td><td></td><td>$'+fmt(shown)+'</td></tr>';
  document.getElementById('ctbody').innerHTML=rows;
  document.getElementById('cfooter').innerHTML=
    '<div class="cnote">Margen desperdicio: '+CS.marg+'%'+(miss.length?' · <span style="color:#e09a3a">Pendientes: '+miss.join(', ')+'</span>':'')+'</div>';
}

/* ─ PANEL TOGGLE ─ */
function togglePanel(name){
  var panel=document.getElementById('calc-panel');
  var btnIds={precios:'pp-btn',recetas:'pr-btn',dist:'pd-btn'};
  var contentIds={precios:'pp-content',recetas:'pr-content',dist:'pd-content'};
  if(OPEN===name){
    // close
    panel.classList.remove('show');
    document.getElementById(btnIds[name]).classList.remove('on');
    OPEN=null;
  } else {
    // switch
    if(OPEN){
      document.getElementById(btnIds[OPEN]).classList.remove('on');
      document.getElementById(contentIds[OPEN]).style.display='none';
    }
    OPEN=name;
    document.getElementById(btnIds[name]).classList.add('on');
    // build content
    if(name==='precios') buildPrices();
    if(name==='recetas') buildRecipes(CTAB.r);
    if(name==='dist') buildDist(CTAB.d);
    document.getElementById(contentIds[name]).style.display='block';
    panel.classList.add('show');
  }
}

/* ─ PRICES ─ */
function buildPrices(){
  var cats={},ord=['Destilados','Aperitivos','Cervezas','Mixers','Frescos'];
  Object.keys(ING).forEach(function(k){var c=ING[k].cat;if(!cats[c])cats[c]=[];cats[c].push(k);});
  var html='';
  ord.forEach(function(cat){
    if(!cats[cat])return;
    html+='<div style="margin-bottom:8px"><div class="pcat">'+cat+'</div>';
    cats[cat].forEach(function(k){
      var i=ING[k];
      var safe=k.replace(/[^a-z0-9]/gi,'_');
      html+='<div class="prow">'+
        '<span class="prow-n">'+(i.alc?'<span class="alcd">⬤</span>':'<span class="mixd">⬤</span>')+k+'</span>'+
        '<input class="prow-i'+(i.p===null?' ms':'')+'" id="pi_'+safe+'" type="number" value="'+(i.p!=null?i.p:'')+'" placeholder="—" oninput="updPrice(\''+k+'\',this)">'+
        '<span class="prow-u">'+i.unit+'</span></div>';
    });
    html+='</div>';
  });
  document.getElementById('pgrid').innerHTML=html;
  updMissCount();
}
function updPrice(key,inp){
  var v=parseFloat(inp.value);
  ING[key].p=(isNaN(v)||v<=0)?null:v;
  inp.classList.toggle('ms',ING[key].p===null);
  updMissCount();render();memSave();
}
function updMissCount(){
  var m=Object.keys(ING).filter(function(k){return ING[k].p===null;}).length;
  var el=document.getElementById('mc');
  el.textContent=m>0?m+' precios pendientes':'Todos los precios cargados';
  el.style.color=m>0?'#e09a3a':'#6aab8a';
}

/* ─ RECIPES ─ */
function buildRecipes(tab){
  var html='';
  DR[tab].forEach(function(d,di){
    var tot=d.ing.reduce(function(s,i){return s+i.ml;},0);
    var alc=d.ing.reduce(function(s,i){return s+(ING[i.k]&&ING[i.k].alc?i.ml:0);},0);
    var ap=tot>0?Math.round(alc/tot*100):0;
    html+='<div class="rcrd"><div class="rcrd-h">'+
      '<span class="rcrd-n">'+d.name+'</span>'+
      '<span class="rcrd-s">'+tot+' ml total · <span style="color:var(--dorado)">'+alc+' ml alc ('+ap+'%)</span></span></div>';
    d.ing.forEach(function(ing,ii){
      var pct=tot>0?ing.ml/tot*100:0,isA=ING[ing.k]&&ING[ing.k].alc;
      html+='<div class="iring">'+
        '<span class="iring-k">'+(isA?'<span class="alcd">⬤</span>':'<span class="mixd">⬤</span>')+ing.k+'</span>'+
        '<input class="iring-i" type="number" min="0" max="999" value="'+ing.ml+'" oninput="updMl(\''+tab+'\','+di+','+ii+',this.value)">'+
        '<span class="iring-u">ml</span>'+
        '<div class="bbar"><div class="bfil '+(isA?'a':'m')+'" style="width:'+Math.min(100,pct).toFixed(1)+'%"></div></div>'+
        '<span class="bpct">'+Math.round(pct)+'%</span></div>';
    });
    html+='</div>';
  });
  document.getElementById('r-body').innerHTML=html;
}
function updMl(tier,di,ii,val){
  var v=parseFloat(val);DR[tier][di].ing[ii].ml=isNaN(v)||v<0?0:v;
  buildRecipes(tier);render();memSave();
}

/* ─ DIST ─ */
function buildDist(tab){
  var all=allDrinks(tab),tw=all.reduce(function(s,d){return s+d.w;},0);
  var grps=[{l:'Estándar',dr:DR.estandar,t:'estandar'}];
  if(tab==='plus'||tab==='autor')grps.push({l:'Plus — adicionales',dr:DR.plus,t:'plus'});
  if(tab==='autor')grps.push({l:'Autor — adicionales',dr:DR.autor,t:'autor'});
  var html='';
  grps.forEach(function(g){
    html+='<div class="dg-lbl">'+g.l+'</div>';
    g.dr.forEach(function(d,di){
      var pct=tw>0?d.w/tw*100:0;
      html+='<div class="drow">'+
        '<span class="drow-n">'+d.name+'</span>'+
        '<input class="drow-i" type="number" min="0" max="999" value="'+d.w+'" oninput="updW(\''+g.t+'\','+di+',this.value,\''+tab+'\')">'+
        '<span class="drow-u">pts</span>'+
        '<div class="dbbar"><div class="dbfil" style="width:'+Math.min(100,pct).toFixed(1)+'%"></div></div>'+
        '<span class="dpct">'+pct.toFixed(1)+'%</span></div>';
    });
  });
  html+='<div class="dtot">Total: <strong>'+tw+'</strong> pts → 100%</div>';
  document.getElementById('d-body').innerHTML=html;
}
function updW(tier,di,val,tab){
  var v=parseFloat(val);DR[tier][di].w=isNaN(v)||v<0?0:v;
  buildDist(tab);render();memSave();
}

/* ─ TAB / PICK / SLIDER ─ */
function setTab(panel,tab,btn){
  CTAB[panel]=tab;
  var tabsId=panel===('r')?'r-tabs':'d-tabs';
  document.querySelectorAll('#'+tabsId+' .ptab').forEach(function(t){t.classList.remove('on');});
  btn.classList.add('on');
  if(panel==='r')buildRecipes(tab);
  if(panel==='d')buildDist(tab);
}
function pick(key,val,gId,btn){
  CS[key]=val;
  document.getElementById(gId).querySelectorAll('.cbtn').forEach(function(b){b.classList.remove('on');});
  btn.classList.add('on');
  render();
}
function setSlider(key,val,outId,fn){CS[key]=val;document.getElementById(outId).textContent=fn(val);render();}
function setBar(b,btn){
  CS.bar=b;
  document.querySelectorAll('.btab').forEach(function(t){t.classList.remove('on');});
  btn.classList.add('on');
  render();
}

/* ─── MEMORIA (localStorage) ─── */
var MEM='casavaso_v1';

function memSave(){
  try{
    // Precios
    var prices={};
    Object.keys(ING).forEach(function(k){prices[k]=ING[k].p;});
    // Recetas (ml) y distribución (w)
    var dr={
      estandar:DR.estandar.map(function(d){return {w:d.w,ing:d.ing.map(function(i){return {k:i.k,ml:i.ml};})};}),
      plus:    DR.plus.map(function(d){return {w:d.w,ing:d.ing.map(function(i){return {k:i.k,ml:i.ml};})};}),
      autor:   DR.autor.map(function(d){return {w:d.w,ing:d.ing.map(function(i){return {k:i.k,ml:i.ml};})};})
    };
    // Textos editables (por índice de aparición en el DOM)
    var texts=[];
    document.querySelectorAll('[contenteditable]').forEach(function(el){texts.push(el.innerHTML);});
    localStorage.setItem(MEM,JSON.stringify({prices:prices,dr:dr,texts:texts}));
    // Indicador visual
    var si=document.getElementById('saved-ind');
    if(si){si.style.opacity='1';clearTimeout(window._st);window._st=setTimeout(function(){si.style.opacity='0';},1800);}
  }catch(e){console.warn('memSave error:',e);}
}

function memLoad(){
  try{
    var raw=localStorage.getItem(MEM);
    if(!raw)return;
    var d=JSON.parse(raw);
    // Precios
    if(d.prices)Object.keys(d.prices).forEach(function(k){if(ING[k])ING[k].p=d.prices[k];});
    // Recetas y distribución
    if(d.dr)['estandar','plus','autor'].forEach(function(t){
      if(!d.dr[t])return;
      d.dr[t].forEach(function(dd,di){
        if(!DR[t][di])return;
        DR[t][di].w=dd.w;
        dd.ing.forEach(function(i,ii){
          if(DR[t][di].ing[ii])DR[t][di].ing[ii].ml=i.ml;
        });
      });
    });
    // Textos (se aplican después de que el DOM esté listo)
    if(d.texts)window._memTexts=d.texts;
  }catch(e){console.warn('memLoad error:',e);}
}

function memLoadTexts(){
  if(!window._memTexts)return;
  var els=document.querySelectorAll('[contenteditable]');
  window._memTexts.forEach(function(txt,i){
    if(els[i]&&txt!==undefined&&txt!==null)els[i].innerHTML=txt;
  });
}

function memReset(){
  if(!confirm('¿Resetear todo al estado original?\n\nSe borrarán los precios, ml, distribución y textos que hayas editado.'))return;
  localStorage.removeItem(MEM);
  location.reload();
}

// Arranque: cargar datos, renderizar, luego aplicar textos
memLoad();
render();
memLoadTexts();

// Guardar textos automáticamente al salir de un campo editable
document.querySelectorAll('[contenteditable]').forEach(function(el){
  el.addEventListener('blur',memSave);
});
</script>
