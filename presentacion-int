<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Casa Vaso — Presentación</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,400&family=Great+Vibes&family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
:root{
  --bordo:#5C0A0A;--bordo-dk:#3a0606;
  --dorado:#C9A961;--crema:#F5EDE0;--crema7:rgba(245,237,224,.7);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{width:100%;height:100%;overflow:hidden;background:#1a0202;font-family:'DM Sans',sans-serif}

/* ─── SLIDE ENGINE ─── */
.deck{width:100%;height:100%;position:relative}
.slide{
  position:absolute;inset:0;opacity:0;pointer-events:none;
  transition:opacity .45s ease,transform .45s ease;
  transform:translateY(16px);
  background:linear-gradient(140deg,var(--bordo) 0%,var(--bordo-dk) 100%);
}
.slide.active{opacity:1;pointer-events:all;transform:translateY(0)}

/* ─── NAV BAR ─── */
#nav{
  position:fixed;bottom:22px;left:50%;transform:translateX(-50%);
  display:flex;align-items:center;gap:8px;z-index:9999;
  background:rgba(0,0,0,.55);backdrop-filter:blur(14px);
  border:1px solid rgba(201,169,97,.25);border-radius:40px;padding:7px 14px;
}
.nbtn{width:30px;height:30px;border-radius:50%;border:1px solid rgba(201,169,97,.3);
  background:none;color:var(--dorado);cursor:pointer;font-size:13px;
  display:flex;align-items:center;justify-content:center;transition:all .15s}
.nbtn:hover{background:var(--dorado);color:var(--bordo)}
#ctr{font-size:11px;color:rgba(201,169,97,.65);min-width:44px;text-align:center;font-family:'DM Sans',sans-serif}
.dot{width:6px;height:6px;border-radius:50%;background:rgba(201,169,97,.25);cursor:pointer;transition:all .2s}
.dot.active{background:var(--dorado);width:16px;border-radius:3px}

/* ─── EDIT HINT ─── */
#hint{position:fixed;top:14px;right:14px;z-index:9999;font-size:11px;
  color:rgba(201,169,97,.5);background:rgba(0,0,0,.35);
  border:1px solid rgba(201,169,97,.15);border-radius:5px;padding:4px 9px;pointer-events:none}

/* ─── EDITABLE ─── */
[contenteditable]{outline:none;cursor:text;border-radius:2px;
  border-bottom:1px dashed transparent;transition:border-color .15s}
[contenteditable]:hover{border-bottom:1px dashed rgba(201,169,97,.4)}
[contenteditable]:focus{border-bottom:1px dashed var(--dorado);background:rgba(201,169,97,.07)}

/* ─── SHARED ─── */
.sep{font-size:11px;letter-spacing:.35em;color:var(--dorado);font-family:'DM Sans',sans-serif}
.glass{background:rgba(10,0,0,.4);backdrop-filter:blur(10px);border:1px solid rgba(201,169,97,.18);border-radius:4px}
.script{font-family:'Great Vibes',cursive;color:var(--dorado)}
.serif{font-family:'Cormorant Garamond',serif}

/* ═══════════════════════════════
   SLIDE 1 — HERO
═══════════════════════════════ */
#s1{display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden}
#s1 .bg-img{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1514362545857-3bc16c4c7d1b?auto=format&fit=crop&q=80&w=2000')center/cover;opacity:.15}
#s1 .bg-grad{position:absolute;inset:0;background:linear-gradient(180deg,transparent 40%,var(--bordo-dk)100%)}
#s1 .content{position:relative;z-index:1;padding:0 5%}
#s1 h1{font-family:'Great Vibes',cursive;font-size:clamp(64px,10vw,130px);color:var(--dorado);line-height:1}
#s1 .subtitle{font-family:'Cormorant Garamond',serif;font-size:clamp(16px,2.5vw,30px);letter-spacing:.5em;text-transform:uppercase;color:var(--crema);font-weight:300;margin:14px 0}
#s1 .tagline{font-family:'Cormorant Garamond',serif;font-size:clamp(14px,1.6vw,20px);font-style:italic;color:var(--crema7);max-width:520px}
#s1 .loc{font-size:12px;letter-spacing:.4em;text-transform:uppercase;color:var(--dorado);margin-top:22px;opacity:.75}
#s1 .line{width:50px;height:1px;background:var(--dorado);margin:18px auto;opacity:.45}

/* ═══════════════════════════════
   SLIDE 2 — NOSOTROS
═══════════════════════════════ */
#s2{display:grid;grid-template-columns:1fr 1fr;gap:0;overflow:hidden}
#s2 .col{padding:60px 5%}
#s2 .col-l{display:flex;flex-direction:column;justify-content:center;border-right:1px solid rgba(201,169,97,.15)}
#s2 .col-l h2{font-family:'Great Vibes',cursive;font-size:clamp(44px,6vw,80px);color:var(--dorado);line-height:1;margin:10px 0}
#s2 .col-l p{font-family:'Cormorant Garamond',serif;font-size:clamp(15px,1.5vw,19px);color:var(--crema7);line-height:1.85;margin-bottom:10px}
#s2 .col-r{display:flex;flex-direction:column;justify-content:center;gap:20px}
#s2 .pillar{display:flex;gap:14px;align-items:flex-start;padding:14px;background:rgba(10,0,0,.35);border:1px solid rgba(201,169,97,.14);border-radius:4px}
#s2 .pnum{font-family:'Cormorant Garamond',serif;font-size:52px;color:var(--dorado);opacity:.25;line-height:1;min-width:42px}
#s2 .pbody h3{font-family:'Cormorant Garamond',serif;font-size:clamp(14px,1.4vw,18px);color:var(--dorado);text-transform:uppercase;letter-spacing:.1em;margin-bottom:5px}
#s2 .pbody p{font-size:clamp(11px,1vw,13px);color:var(--crema7);line-height:1.65}

/* ═══════════════════════════════
   SLIDES 3-5 — BARRAS
═══════════════════════════════ */
.sbarra{display:flex;flex-direction:column;overflow:hidden;padding:44px 6%}
.bh{display:flex;justify-content:space-between;align-items:flex-end;
  border-bottom:1px solid rgba(201,169,97,.18);padding-bottom:16px;margin-bottom:24px;flex-wrap:wrap;gap:10px}
.bh h2{font-family:'Great Vibes',cursive;font-size:clamp(40px,6vw,74px);color:var(--dorado)}
.bh .pr{text-align:right}
.bh .pr-lbl{font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--dorado)}
.bh .pr-val{font-family:'Cormorant Garamond',serif;font-size:clamp(26px,3vw,44px);color:var(--crema);font-weight:300}
.dgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px;flex:1}
.dcard{padding:13px 15px;background:rgba(10,0,0,.38);border:1px solid rgba(201,169,97,.16);border-radius:4px;transition:transform .2s}
.dcard:hover{transform:translateY(-2px)}
.dcard .dn{font-family:'Cormorant Garamond',serif;font-size:clamp(13px,1.3vw,17px);color:var(--dorado);text-transform:uppercase;letter-spacing:.07em;font-weight:600}
.dcard .di{font-size:clamp(10px,.9vw,12px);color:var(--crema7);margin-top:4px;line-height:1.5}
.dcard .dm{font-size:10px;color:rgba(201,169,97,.4);margin-top:5px}
.incl{font-size:11px;color:rgba(201,169,97,.6);font-style:italic;margin-bottom:14px}

/* ═══════════════════════════════
   SLIDE 6 — VINOS
═══════════════════════════════ */
#s6{display:grid;grid-template-columns:1fr 1fr;overflow:hidden}
#s6 .vcol{padding:48px 5%;overflow:hidden;display:flex;flex-direction:column}
#s6 .vcol:first-child{border-right:1px solid rgba(201,169,97,.15)}
#s6 h2{font-family:'Great Vibes',cursive;font-size:clamp(34px,4.5vw,58px);color:var(--dorado);margin:8px 0 16px}
#s6 .sec{font-size:10px;font-weight:500;letter-spacing:.18em;text-transform:uppercase;color:var(--dorado);opacity:.65;margin:16px 0 8px}
#s6 .pi{display:flex;justify-content:space-between;align-items:baseline;padding:9px 0;border-bottom:1px solid rgba(201,169,97,.1)}
#s6 .pi:last-child{border:none}
#s6 .pn{font-family:'Cormorant Garamond',serif;font-size:clamp(14px,1.4vw,17px);color:var(--crema)}
#s6 .ps{font-size:10px;color:rgba(245,237,224,.35);display:block;margin-top:2px}
#s6 .pp{font-family:'Cormorant Garamond',serif;font-size:clamp(13px,1.3vw,16px);color:var(--dorado);white-space:nowrap;margin-left:10px}

/* ═══════════════════════════════
   SLIDE 7 — CALCULADORA
   Arquitectura nueva: sin scroll anidado
═══════════════════════════════ */
#s7{
  display:flex;flex-direction:column;
  overflow:hidden;
}
/* Header fijo */
#calc-hdr{
  flex-shrink:0;
  background:rgba(0,0,0,.65);
  border-bottom:1px solid rgba(201,169,97,.2);
  padding:10px 20px;
  display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;
}
#calc-hdr .title{font-family:'Great Vibes',cursive;font-size:30px;color:var(--dorado)}
.calc-pills{display:flex;gap:5px;flex-wrap:wrap}
.cpill{padding:4px 13px;font-size:11px;border:1px solid rgba(201,169,97,.3);background:none;
  color:var(--dorado);border-radius:20px;cursor:pointer;transition:all .15s;font-family:'DM Sans',sans-serif}
.cpill:hover{background:rgba(201,169,97,.12)}
.cpill.on{background:var(--dorado);color:var(--bordo);font-weight:500;border-color:var(--dorado)}

/* Área que ocupa el resto de la altura */
#calc-main{
  flex:1;min-height:0; /* crucial para que flex no desborde */
  display:flex;flex-direction:column;
  overflow:hidden;
}

/* Panel desplegable (ocupa espacio propio, empuja contenido abajo) */
#calc-panel{
  flex-shrink:0;
  display:none;
  border-bottom:1px solid rgba(201,169,97,.18);
  background:rgba(0,0,0,.5);
  max-height:42vh;
  overflow-y:auto;
  padding:14px 20px;
}
#calc-panel.show{display:block}
#calc-panel::-webkit-scrollbar{width:5px}
#calc-panel::-webkit-scrollbar-thumb{background:var(--dorado);border-radius:3px}

/* Contenido scrollable de la calc */
#calc-scroll{
  flex:1;min-height:0;
  overflow-y:auto;
  padding:14px 20px 80px;
}
#calc-scroll::-webkit-scrollbar{width:5px}
#calc-scroll::-webkit-scrollbar-thumb{background:var(--dorado);border-radius:3px}

/* Panel inner tabs */
.ptabs{display:flex;gap:5px;margin-bottom:12px;flex-wrap:wrap}
.ptab{padding:4px 12px;font-size:11px;border:1px solid rgba(201,169,97,.25);border-radius:4px;
  cursor:pointer;color:rgba(245,237,224,.55);background:none;font-family:'DM Sans',sans-serif;transition:all .15s}
.ptab:hover{color:var(--dorado);border-color:var(--dorado)}
.ptab.on{background:var(--dorado);color:var(--bordo);border-color:var(--dorado)}

/* Controls */
.cc-box{border:1px solid rgba(201,169,97,.15);border-radius:8px;padding:11px 14px;margin-bottom:10px;background:rgba(0,0,0,.2)}
.cc-row{display:flex;gap:8px;align-items:center;margin-bottom:8px;flex-wrap:wrap}
.cc-row:last-child{margin-bottom:0}
.cc-lbl{font-size:11px;color:rgba(245,237,224,.55);width:148px;flex-shrink:0}
.cbtng{display:flex;gap:4px}
.cbtn{padding:5px 12px;font-size:11px;border:1px solid rgba(201,169,97,.22);background:none;
  color:rgba(245,237,224,.55);border-radius:5px;cursor:pointer;transition:all .15s;font-family:'DM Sans',sans-serif}
.cbtn:hover{border-color:var(--dorado);color:var(--dorado)}
.cbtn.on{background:var(--dorado);color:var(--bordo);border-color:var(--dorado)}

/* Bar tabs */
.btabs{display:flex;border-bottom:1px solid rgba(201,169,97,.18);margin-bottom:11px}
.btab{padding:7px 14px;font-size:12px;font-weight:500;cursor:pointer;border-bottom:2px solid transparent;
  color:rgba(245,237,224,.45);background:none;border-top:none;border-left:none;border-right:none;
  font-family:'DM Sans',sans-serif;transition:all .15s}
.btab:hover{color:var(--dorado)}
.btab.on{color:var(--dorado);border-bottom:2px solid var(--dorado)}

/* Summary cards */
.sgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;margin-bottom:11px}
.sc{background:rgba(0,0,0,.4);border:1px solid rgba(201,169,97,.14);border-radius:7px;padding:10px 12px}
.sc-l{font-size:10px;text-transform:uppercase;letter-spacing:.04em;color:rgba(245,237,224,.45);margin-bottom:3px}
.sc-v{font-family:'Cormorant Garamond',serif;font-size:22px;color:var(--crema)}
.sc-v.g{color:#6aab8a}.sc-v.a{color:#e09a3a}
.sc-s{font-size:10px;color:rgba(245,237,224,.3);margin-top:2px}

/* Table */
.tw{overflow-x:auto;border:1px solid rgba(201,169,97,.14);border-radius:7px}
.ctbl{width:100%;border-collapse:collapse;font-size:12px;font-family:'DM Sans',sans-serif;min-width:480px}
.ctbl th{text-align:left;padding:7px 10px;font-size:10px;font-weight:500;
  color:rgba(245,237,224,.4);border-bottom:1px solid rgba(201,169,97,.14);
  text-transform:uppercase;letter-spacing:.04em;background:rgba(0,0,0,.3)}
.ctbl td{padding:7px 10px;border-bottom:1px solid rgba(201,169,97,.07);color:var(--crema);vertical-align:middle}
.ctbl tr:last-child td{border-bottom:none}
.ctbl tr:hover td{background:rgba(201,169,97,.04)}
.ttr td{font-weight:600;background:rgba(0,0,0,.3);color:var(--dorado)}
.bp{background:rgba(224,154,58,.2);color:#e09a3a;font-size:10px;padding:2px 6px;border-radius:3px}
.alcd{color:var(--dorado);font-size:8px;margin-right:2px}
.mixd{color:#6aab8a;font-size:8px;margin-right:2px}

/* Recipe cards */
.rcrd{border:1px solid rgba(201,169,97,.14);border-radius:7px;padding:11px 13px;margin-bottom:8px;background:rgba(0,0,0,.2)}
.rcrd-h{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:8px;flex-wrap:wrap;gap:4px}
.rcrd-n{font-family:'Cormorant Garamond',serif;font-size:16px;color:var(--dorado)}
.rcrd-s{font-size:11px;color:rgba(245,237,224,.45)}
.iring{display:flex;align-items:center;gap:7px;padding:4px 0;border-bottom:1px solid rgba(201,169,97,.07)}
.iring:last-child{border:none}
.iring-k{font-size:11px;width:145px;flex-shrink:0;color:rgba(245,237,224,.8)}
.iring-i{width:56px;font-size:12px;padding:3px 6px;border:1px solid rgba(201,169,97,.2);
  border-radius:4px;background:rgba(0,0,0,.3);color:var(--crema);text-align:right}
.iring-i:focus{outline:none;border-color:var(--dorado)}
.iring-u{font-size:10px;color:rgba(245,237,224,.3);width:16px}
.bbar{flex:1;height:5px;background:rgba(255,255,255,.07);border-radius:3px;overflow:hidden;min-width:30px}
.bfil{height:100%;border-radius:3px}
.bfil.a{background:var(--dorado)}.bfil.m{background:#6aab8a}
.bpct{font-size:11px;color:rgba(245,237,224,.4);width:30px;text-align:right}

/* Dist */
.dg-lbl{font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:.05em;
  color:rgba(245,237,224,.4);padding:8px 0 3px;border-bottom:1px solid rgba(201,169,97,.14);margin-bottom:3px}
.drow{display:flex;align-items:center;gap:7px;padding:5px 0;border-bottom:1px solid rgba(201,169,97,.06)}
.drow-n{font-size:12px;width:158px;flex-shrink:0;color:rgba(245,237,224,.8)}
.drow-i{width:50px;font-size:12px;padding:3px 5px;border:1px solid rgba(201,169,97,.2);
  border-radius:4px;background:rgba(0,0,0,.3);color:var(--crema);text-align:right}
.drow-i:focus{outline:none;border-color:var(--dorado)}
.drow-u{font-size:10px;color:rgba(245,237,224,.35);width:22px}
.dbbar{flex:1;height:5px;background:rgba(255,255,255,.07);border-radius:3px;overflow:hidden}
.dbfil{height:100%;background:var(--dorado);border-radius:3px}
.dpct{font-size:12px;font-weight:500;width:44px;text-align:right;color:var(--dorado)}
.dtot{font-size:11px;color:rgba(245,237,224,.4);text-align:right;padding-top:8px;
  border-top:1px solid rgba(201,169,97,.14);margin-top:5px}

/* Price editor */
.pgrid{display:grid;grid-template-columns:1fr 1fr;gap:0 22px}
.pcat{font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:.05em;
  color:rgba(245,237,224,.4);padding:8px 0 3px;border-bottom:1px solid rgba(201,169,97,.14);margin-bottom:3px}
.prow{display:flex;align-items:center;gap:6px;padding:4px 0;border-bottom:1px solid rgba(201,169,97,.05)}
.prow:last-child{border:none}
.prow-n{font-size:12px;flex:1;color:rgba(245,237,224,.8)}
.prow-i{width:82px;font-size:12px;padding:3px 6px;border:1px solid rgba(201,169,97,.2);
  border-radius:4px;background:rgba(0,0,0,.3);color:var(--crema);text-align:right}
.prow-i:focus{outline:none;border-color:var(--dorado)}
.prow-i.ms{border-color:#e09a3a;background:rgba(224,154,58,.1)}
.prow-u{font-size:10px;color:rgba(245,237,224,.35);min-width:56px;text-align:right}
.cnote{font-size:11px;color:rgba(245,237,224,.4);border:1px solid rgba(201,169,97,.12);
  border-radius:6px;padding:8px 12px;margin-top:10px;line-height:1.6}

/* ═══════════════════════════════
   SLIDE 8 — CONTACTO
═══════════════════════════════ */
#s8{display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden}
#s8 .bg-img{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1575023782549-62ca0d244b39?auto=format&fit=crop&q=80&w=2000')center/cover;opacity:.1}
#s8 .content{position:relative;z-index:1;padding:0 6%;max-width:580px}
#s8 h2{font-family:'Great Vibes',cursive;font-size:clamp(60px,9vw,110px);color:var(--dorado);line-height:1}
#s8 .clist{display:flex;flex-direction:column;gap:18px;margin-top:28px;text-align:left}
#s8 .ci{display:flex;align-items:center;gap:14px}
#s8 .ci-ico{width:40px;height:40px;border-radius:50%;border:1px solid rgba(201,169,97,.35);
  display:flex;align-items:center;justify-content:center;font-size:15px;flex-shrink:0}
#s8 .ci-lbl{font-size:10px;text-transform:uppercase;letter-spacing:.15em;color:var(--dorado);margin-bottom:3px}
#s8 .ci-val{font-family:'Cormorant Garamond',serif;font-size:18px;color:var(--crema)}

@media(max-width:680px){
  #s2{grid-template-columns:1fr}
  #s6{grid-template-columns:1fr}
  .sgrid{grid-template-columns:repeat(2,1fr)}
  .pgrid{grid-template-columns:1fr}
  .dgrid{grid-template-columns:1fr 1fr}
}
</style>
</head>
<body>

<div id="hint">✎ Doble click para editar cualquier texto</div>
<div id="saved-ind" style="position:fixed;top:14px;left:14px;z-index:9999;font-size:11px;color:rgba(201,169,97,.85);background:rgba(0,0,0,.45);border:1px solid rgba(201,169,97,.2);border-radius:5px;padding:4px 10px;opacity:0;transition:opacity .3s;pointer-events:none">✓ Guardado</div>
<button onclick="memReset()" title="Volver a los valores originales" style="position:fixed;top:14px;left:110px;z-index:9999;font-size:10px;color:rgba(201,169,97,.4);background:rgba(0,0,0,.3);border:1px solid rgba(201,169,97,.1);border-radius:5px;padding:4px 9px;cursor:pointer;transition:all .15s" onmouseover="this.style.color='rgba(201,169,97,.9)'" onmouseout="this.style.color='rgba(201,169,97,.4)'">↺ Resetear</button>

<div class="deck">

<!-- ══ S1 HERO ══ -->
<div class="slide" id="s1">
  <div class="bg-img"></div><div class="bg-grad"></div>
  <div class="content">
    <h1 contenteditable spellcheck="false">Casa Vaso</h1>
    <div class="line"></div>
    <div class="subtitle serif" contenteditable spellcheck="false">Barra de Autor para Eventos</div>
    <div class="tagline" contenteditable spellcheck="false">Coctelería clásica preparada con precisión. Ingredientes frescos y atención al detalle.</div>
    <div class="loc" contenteditable spellcheck="false">● CABA, Argentina</div>
  </div>
</div>

<!-- ══ S2 NOSOTROS ══ -->
<div class="slide" id="s2">
  <div class="col col-l">
    <div class="sep" contenteditable spellcheck="false">+ + +</div>
    <h2 contenteditable spellcheck="false">Quiénes somos</h2>
    <p contenteditable spellcheck="false">Casa Vaso es una barra de tragos donde la coctelería se vive como ritual. Cada preparación es un gesto cuidado, una búsqueda de equilibrio entre tradición y precisión.</p>
    <p contenteditable spellcheck="false">Trabajamos con ingredientes frescos y una estética que respeta el oficio. Más de <strong>50 eventos realizados</strong> en CABA y GBA.</p>
  </div>
  <div class="col col-r">
    <div class="pillar">
      <div class="pnum">01</div>
      <div class="pbody"><h3 contenteditable spellcheck="false">Coctelería clásica</h3><p contenteditable spellcheck="false">Respetamos las recetas icónicas y las preparamos con precisión absoluta. Cada trago es técnica y equilibrio.</p></div>
    </div>
